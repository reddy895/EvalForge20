# EvalForge20 Environment Configuration

# Core Application Settings
EVALFORGE20_ENV=development
EVALFORGE20_DEBUG=false
EVALFORGE20_DATABASE_URL=sqlite:///./data/evalforge20.db
EVALFORGE20_LOG_LEVEL=INFO
EVALFORGE20_LOG_PROMPTS=false
EVALFORGE20_DATA_DIR=./data

# Concurrency & Execution Limits
EVALFORGE20_MAX_CONCURRENCY=5
EVALFORGE20_DEFAULT_TIMEOUT_SECONDS=60.0
EVALFORGE20_MAX_OUTPUT_BYTES=524288

# Provider: Ollama Local Inference
EVALFORGE20_OLLAMA_BASE_URL=http://localhost:11434
EVALFORGE20_OLLAMA_TIMEOUT_SECONDS=120.0

# Optional LangSmith Integration
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=evalforge20-default
LANGSMITH_AUTO_SYNC_DATASETS=false
