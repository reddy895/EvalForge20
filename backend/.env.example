# ==============================================================================
# EvalForge20 — Application Environment Configuration Template
# Copy this file to '.env' and adjust settings for your environment.
# Local-first operation requires NO cloud API keys. Local Ollama is supported out-of-the-box.
# ==============================================================================

# Application Metadata
APP_NAME=EvalForge20
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=development

# Server Binding
# Binds to localhost (127.0.0.1) by default for local security.
# WARNING: Do not bind to 0.0.0.0 on untrusted networks without authentication.
HOST=127.0.0.1
PORT=8000

# Database Persistence
# Default uses asynchronous SQLite (aiosqlite).
# PostgreSQL is supported via asyncpg: postgresql+asyncpg://user:pass@localhost:5432/evalforge
DATABASE_URL=sqlite+aiosqlite:///./evalforge.db
DATABASE_ECHO=false

# Local Ollama Inference Provider (Local-First, No Cloud Credentials Needed)
# Default points to standard local Ollama HTTP API port
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60.0

# Execution Engine & Concurrency Limits
DEFAULT_CONCURRENCY_LIMIT=4
MAX_CONCURRENCY_LIMIT=16
PROVIDER_TIMEOUT_SECONDS=45.0

# Dataset & Security Guardrails
# Maximum dataset upload size in bytes (default: 10MB)
MAX_DATASET_FILE_SIZE_BYTES=10485760
# Maximum test cases allowed per dataset
MAX_CASES_PER_DATASET=2000

# CORS Whitelist (Comma-separated origins for web frontend clients)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Structured Logging
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: 'json' (production/structured) or 'console' (developer-friendly color output)
LOG_FORMAT=console

# ==============================================================================
# Optional Cloud Provider Integrations (Leave empty for purely local execution)
# ==============================================================================
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Groq Cloud
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Cohere
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2

# Together AI
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1

# Fireworks AI
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Hugging Face Inference
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/models

# Microsoft Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Amazon AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Generic OpenAI-Compatible Inference Server (e.g. vLLM, LMStudio, LocalAI, TGI)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=
