{
  "name": "evalforge20",
  "version": "2.1.0",
  "private": true,
  "description": "EvalForge20 — Enterprise-Grade LLM and Agent Evaluation Platform",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start_backend.mjs",
    "dev:backend": "node scripts/start_backend.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:all": "node scripts/start_all.mjs",
    "build": "npm run build --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend"
  },
  "keywords": [
    "llm-evaluation",
    "ollama",
    "benchmarks",
    "ai-agents",
    "fastapi",
    "react"
  ],
